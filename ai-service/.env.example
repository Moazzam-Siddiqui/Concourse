# Copy to .env and fill in. .env is gitignored — never commit a real token.
#   cp .env.example .env
#
# EVERYTHING HERE IS OPTIONAL. With no .env at all the service runs on the offline model in
# app/scoring.py and answers every endpoint. Set these only to route inference through
# Hugging Face instead.

# --- Hugging Face Inference API (optional) -----------------------------------
# A read token from https://huggingface.co/settings/tokens
# HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Full endpoint URLs. Either serverless Inference API:
#   https://api-inference.huggingface.co/models/<org>/<model>
# or a dedicated Inference Endpoint:
#   https://<id>.<region>.aws.endpoints.huggingface.cloud
#
# Each is independent: set only HF_GNN_URL and you get hosted risk with local advisory text.
# HF_GNN_URL=https://api-inference.huggingface.co/models/your-org/congestion-gnn
# HF_LLM_URL=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-0.5B-Instruct

# Cosmetic only — reported back in modelInfo so the demo can name what answered.
# HF_GNN_MODEL=your-org/congestion-gnn
# HF_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Timeouts and retries ----------------------------------------------------
# Per-attempt timeout in seconds. Serverless endpoints cold-start; the client also honours
# the estimated_time HF returns with a 503, so it waits the amount it was asked to.
# HF_TIMEOUT_SECONDS=12
# Retries after the first attempt. 2 means up to 3 calls total.
# HF_MAX_RETRIES=2
# HF_LLM_MAX_NEW_TOKENS=90

# --- In-process GNN (optional, and the one the project plan calls for) -------
# Runs the trained congestion GNN inside this process: the checkpoint is fetched once at
# startup and every inference after that is local, so a cold endpoint or bad venue wifi
# cannot take the demo down mid-run. Hugging Face is the model registry here, not a
# per-request dependency.
#
# Needs torch + torch-geometric, which are deliberately NOT in requirements.txt:
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
#   pip install torch-geometric
# Without them the service simply reports it at /health and uses the linear model.
#
# Pull the checkpoint from the Hub (see ml/gnn/export_to_hf.py):
# CONCOURSE_GNN_REPO=your-username/congestion-gnn
# CONCOURSE_GNN_FILE=congestion_gnn.pt
#
# ...or read one straight off disk. Defaults to ml/out/congestion_gnn.pt, which is what a
# local `python ml/gnn/train_gnn.py` leaves behind.
# CONCOURSE_GNN_CHECKPOINT=../ml/out/congestion_gnn.pt

# --- TinyBERT risk model (optional) ------------------------------------------
# The beta path, ported from the old `Python Backend/` service. Renders each zone's features
# as a sentence, encodes it with huawei-noah/TinyBERT_General_4L_312D (~55 MB, CPU, cached
# after the first run) and blends that signal 30/70 with the weighted raw features.
#
# Needs torch + transformers. Off unless set, and when set it takes priority over the trained
# congestion GNN — turning it on means you want it answering.
# CONCOURSE_TINYBERT=true
# CONCOURSE_TINYBERT_MODEL=huawei-noah/TinyBERT_General_4L_312D
#
# Divisor that turns the embedding's L2 norm into a [0,1] signal. The first inference logs the
# norms it saw; retune this if they sit far from it.
# CONCOURSE_TINYBERT_SCALE=10.0

# --- In-process advisory model (optional) ------------------------------------
# Writes the operator advisory with a small instruct model instead of the built-in templates.
# Downloaded from the Hub once and cached, then run locally — no network at request time.
#
# Needs transformers, which is deliberately NOT in requirements.txt:
#   pip install transformers
# Without it the service reports so at /health and uses the templates.
#
# Default is Qwen/Qwen2.5-0.5B-Instruct: ~1 GB, CPU-friendly, and adopted rather than trained —
# turning four facts into one clear sentence is what these models are already good at.
# CONCOURSE_ADVISORY_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# CONCOURSE_ADVISORY_MAX_TOKENS=64
#
# Set to false to force the templates even when transformers is installed — useful if the
# machine is busy and you want the deterministic, instant path during a demo.
# CONCOURSE_ADVISORY_LOCAL=true

# --- Offline model -----------------------------------------------------------
# Set to false to make hosted inference mandatory: a missing token or a dead endpoint then
# returns 502 instead of quietly falling through to the local scorer. Useful when you are
# specifically testing the Hugging Face path and want its failures to be loud.
# CONCOURSE_LOCAL_FALLBACK=true

# --- Server ------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# LOG_LEVEL=INFO
