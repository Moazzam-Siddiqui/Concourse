# Copy to .env next to docker-compose.yml. Everything here is optional — the stack boots with
# no .env at all. Full explanation in docs/ci-cd.md.
#
#   cp .env.docker.example .env

# --- database ---------------------------------------------------------------
DB_PASSWORD=concourse-local-only

# --- auth -------------------------------------------------------------------
# Must not be the committed development default; the cloud profile refuses to boot on it.
AUTH_JWT_SECRET=compose-local-only-secret-change-before-deploying-0000

# Who gets the operations console. Empty means nobody does, which is the default.
AUTH_ADMIN_EMAILS=
# Seeds that admin at boot if the account does not exist. 8+ chars, a letter and a number.
# An account that already exists is never overwritten.
AUTH_ADMIN_PASSWORD=

# --- AI ---------------------------------------------------------------------
# Empty is fine: the service answers from the offline model in app/scoring.py.
HF_API_TOKEN=

# Set false for a much smaller ai-service image without the layout pipeline. /analyze still
# works; /layout/* reports unavailable.
WITH_LAYOUT=true

# --- host ports -------------------------------------------------------------
# Change these when something already owns the default.
POSTGRES_PORT=5432
AI_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- frontend ---------------------------------------------------------------
# Baked into the bundle at build time by Vite, so changing these needs a rebuild of the
# frontend image, not just a restart.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
VITE_AI_SERVICE_URL=http://localhost:8000
