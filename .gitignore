# Build output
target/
dist/
build/

# Dependencies
node_modules/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets — every *.example file in this repo is a committed template; the real one never is.
.env
.env.local
secrets.yml

# Editor / tooling
# Local MCP server config. References its key as ${API_KEY_21ST} so it leaks nothing, but it is
# one developer's tooling rather than part of the project.
.mcp.json
.idea/
.vscode/
.DS_Store
.impeccable/

# Trained model checkpoints — large, and regenerated by ml/gnn/train_gnn.py
ml/out/

# JVM crash dumps. Written next to wherever java was launched from.
hs_err_pid*.log
replay_pid*.log

# Agent tooling installed per-machine by `npx skills add`. Third-party skills that run with
# full agent permissions, so they are a personal choice rather than a project dependency —
# same reasoning as .mcp.json above.
.agents/
.claude/
skills-lock.json

# Downloaded archives. Nothing in this repo is delivered as one.
*.zip

# CI scratch. The pipeline builds these in the workspace; none of it is source.
ai-service/.venv-ci/
ai-service/pytest-results.xml
compose-logs.txt

# Local browser-verification tooling: hardcodes a Windows Edge path, useful only on
# this machine.
frontend/probe.mjs
frontend/shot.mjs
